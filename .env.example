PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# -------------------------------------------------------------
# MONGODB (production persistence on Render)
# Leave unset to use the local JSON file (server/src/data/db.json),
# which is fine for development but NOT persistent on Render.
# Create a free cluster at https://cloud.mongodb.com, then add:
# -------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ecomind

# -------------------------------------------------------------
# GEMINI (AI coach chat in Insights)
# Free key from https://aistudio.google.com (no billing needed).
# Leave unset and the chat degrades gracefully to a "not connected"
# notice while recommendations keep working.
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# EMAIL VERIFICATION
# Local/paid Render: SMTP works, so EMAIL_USER + EMAIL_PASS
# (a Gmail app password) are enough.
#
# Render FREE tier blocks outbound SMTP ports 25/465/587, so
# production uses a Google Apps Script HTTPS endpoint instead.
#   1. Create a script at https://script.google.com with the
#      doPost() code from the README/setup notes.
#   2. Deploy as Web app: Execute as Me, access: Anyone.
#   3. Set GMAIL_SCRIPT_URL to the /exec URL.
#   4. Set GMAIL_SCRIPT_SECRET to a long random secret and use
#      the same value inside the script.
# This sends through the Google account that owns the script and
# has no OAuth refresh token to expire. Use a dedicated EcoMind
# Gmail account, not a personal inbox. Consumer Gmail quota:
# 100 recipients/day.
# Mailjet/Brevo remain optional fallbacks but need a real domain
# for reliable delivery (Gmail senders fail DMARC).
# -------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
